<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v3 installer manifest for Coding Unicorns.

  Build requirements:
    - WiX Toolset v3 (candle.exe / light.exe)
    - assets\icon.ico  (generate with scripts\New-Icon.ps1)
    - target\release\coding-unicorns.exe

  Build commands (from the project root):
    candle.exe -arch x64 -dProductVersion=0.10.0 -out wix\main.wixobj wix\main.wxs
    light.exe  -ext WixUIExtension -out coding-unicorns-setup.msi wix\main.wixobj

  Or via cargo-wix:
    cargo wix -no-build -nocapture
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product Id="*"
           Name="Coding Unicorns"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="Coding Unicorns"
           UpgradeCode="{B7E3F4A2-9C5D-4F8B-A1E3-D5C7B9F2E4A6}">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Coding Unicorns — lightweight IDE"
             Comments="Coding Unicorns installer" />

    <!-- Prevent downgrade -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Coding Unicorns is already installed." />

    <!-- Embed the cabinet into the MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Application icon (shown in Add/Remove Programs) -->
    <Icon Id="AppIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK"    Value="https://github.com/Ajustor/codingUnicorns" />

    <!-- Minimal install UI: progress bar + finish -->
    <UIRef Id="WixUI_Minimal" />
    <!-- Remove the mandatory license dialog by supplying a blank RTF -->
    <WixVariable Id="WixUILicenseRtf" Value="wix\License.rtf" />

    <!-- ── Directory layout ─────────────────────────────────────────────── -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Coding Unicorns" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Coding Unicorns" />
      </Directory>
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>

    <!-- ── Features ─────────────────────────────────────────────────────── -->
    <Feature Id="ProductFeature" Title="Coding Unicorns" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ProductShortcuts" />
      <ComponentRef Id="FileAssociations" />
    </Feature>

    <!-- ── Components ───────────────────────────────────────────────────── -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File Id="MainExecutable"
              Name="coding-unicorns.exe"
              Source="target\release\coding-unicorns.exe"
              KeyPath="yes" />
      </Component>

      <!-- CLI alias: "cu" command available from any terminal -->
      <Component Id="CliAlias" Guid="*">
        <File Id="CliAlias"
              Name="cu.cmd"
              Source="scripts\cu.cmd"
              KeyPath="yes" />
        <!-- Add the install folder to the system PATH so "cu" works everywhere -->
        <Environment Id="PATH"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── "Open with" for text files ───────────────────────────────────────
         Offers Coding Unicorns in Explorer's "Open with" menu without taking over
         any extension's default program: OpenWithProgids only adds a candidate.
         Users can still make it the default from Settings > Default apps, which
         reads the Capabilities registered below. All keys are removed on uninstall. -->
    <?define TextExtensions = "txt;text;md;markdown;log;csv;tsv;json;jsonc;toml;yaml;yml;xml;ini;cfg;conf;properties;env;gitignore;gitattributes;editorconfig;rs;py;pyw;js;jsx;mjs;cjs;ts;tsx;go;cs;csx;java;kt;kts;c;h;cpp;hpp;cc;cxx;html;htm;css;scss;sass;less;vue;svelte;sh;bash;zsh;ps1;psm1;psd1;bat;cmd;sql;lua;rb;php;swift;dart;r;gradle;dockerfile;makefile;mk;cmake;tf;proto;graphql" ?>
    <Component Id="FileAssociations" Directory="INSTALLFOLDER" Guid="{4E2B8C61-7A3F-4D59-9B1E-6C0F2A8D5E73}">
      <!-- ProgId used by every association below -->
      <RegistryValue Root="HKLM" Key="Software\Classes\CodingUnicorns.File"
                     Type="string" Value="Text file (Coding Unicorns)" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\CodingUnicorns.File\DefaultIcon"
                     Type="string" Value="[INSTALLFOLDER]coding-unicorns.exe,0" />
      <RegistryValue Root="HKLM" Key="Software\Classes\CodingUnicorns.File\shell\open\command"
                     Type="string" Value="&quot;[INSTALLFOLDER]coding-unicorns.exe&quot; &quot;%1&quot;" />

      <!-- Friendly name, icon and open command when picked from "Open with" -->
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\coding-unicorns.exe"
                     Name="FriendlyAppName" Type="string" Value="Coding Unicorns" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\coding-unicorns.exe\DefaultIcon"
                     Type="string" Value="[INSTALLFOLDER]coding-unicorns.exe,0" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\coding-unicorns.exe\shell\open\command"
                     Type="string" Value="&quot;[INSTALLFOLDER]coding-unicorns.exe&quot; &quot;%1&quot;" />

      <!-- Any type Windows perceives as text (covers extensions not listed here) -->
      <RegistryValue Root="HKLM" Key="Software\Classes\SystemFileAssociations\text\OpenWithList\coding-unicorns.exe"
                     Type="string" Value="" />

      <!-- Settings > Default apps -->
      <RegistryValue Root="HKLM" Key="Software\CodingUnicorns\Capabilities"
                     Name="ApplicationName" Type="string" Value="Coding Unicorns" />
      <RegistryValue Root="HKLM" Key="Software\CodingUnicorns\Capabilities"
                     Name="ApplicationDescription" Type="string" Value="Lightweight code editor" />
      <RegistryValue Root="HKLM" Key="Software\RegisteredApplications"
                     Name="Coding Unicorns" Type="string" Value="Software\CodingUnicorns\Capabilities" />

      <?foreach Ext in $(var.TextExtensions) ?>
      <RegistryValue Root="HKLM" Key="Software\Classes\.$(var.Ext)\OpenWithProgids"
                     Name="CodingUnicorns.File" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\coding-unicorns.exe\SupportedTypes"
                     Name=".$(var.Ext)" Type="string" Value="" />
      <RegistryValue Root="HKLM" Key="Software\CodingUnicorns\Capabilities\FileAssociations"
                     Name=".$(var.Ext)" Type="string" Value="CodingUnicorns.File" />
      <?endforeach ?>
    </Component>

    <ComponentGroup Id="ProductShortcuts">
      <!-- Start Menu shortcut -->
      <Component Id="StartMenuShortcut"
                 Directory="ApplicationProgramsFolder"
                 Guid="*">
        <Shortcut Id="StartMenuLink"
                  Name="Coding Unicorns"
                  Description="Coding Unicorns — lightweight IDE"
                  Target="[INSTALLFOLDER]coding-unicorns.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\CodingUnicorns"
                       Name="StartMenu"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <!-- Desktop shortcut -->
      <Component Id="DesktopShortcut"
                 Directory="DesktopFolder"
                 Guid="*">
        <Shortcut Id="DesktopLink"
                  Name="Coding Unicorns"
                  Description="Coding Unicorns — lightweight IDE"
                  Target="[INSTALLFOLDER]coding-unicorns.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\CodingUnicorns"
                       Name="Desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Product>
</Wix>
